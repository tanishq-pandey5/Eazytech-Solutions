# ==============================================================================
# EAZY TECH SOLUTIONS — EMAIL DISPATCH CONFIGURATION
# ==============================================================================

# Destination inbox (Where you want to receive new leads and inquiries)
NOTIFICATION_EMAIL=eazytechsolutions@hotmail.com

# ------------------------------------------------------------------------------
# OPTION 1 (EASIEST): RESEND API (Recommended for Vercel)
# Sign up at https://resend.com (free 3,000 emails/mo) and grab your API key.
# Works with any email address! No Google/Microsoft app passwords needed.
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_123456789
# RESEND_FROM="Eazy Tech Solutions <onboarding@resend.dev>"

# ------------------------------------------------------------------------------
# OPTION 2: GMAIL SMTP
# Use ANY personal or business @gmail.com address to send the emails.
# (The emails will still be DELIVERED TO eazytechsolutions@hotmail.com).
# Generate a 16-character Google App Password in your Gmail account security.
# ------------------------------------------------------------------------------
# SMTP_USER=your-personal-or-work@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
