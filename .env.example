# ==============================================================================
# EAZY TECH SOLUTIONS — ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. NOTIFICATION DESTINATION
# The email address that receives website inquiry alerts and lead notifications.
# Defaults to: eazytechsolutions@hotmail.com if omitted.
NOTIFICATION_EMAIL=eazytechsolutions@hotmail.com

# 2. GMAIL SMTP CONFIGURATION (For outgoing email dispatch)
# Use your Google Account email and a 16-character App Password.
# Steps to generate Google App Password:
#   1. Go to Google Account (https://myaccount.google.com)
#   2. Security -> 2-Step Verification (must be enabled)
#   3. Search or scroll to "App Passwords"
#   4. Create an app password for "Website Portal"
#   5. Copy the 16-letter password and paste it below:
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password

# Optional SMTP Settings (defaults are automatically optimized for Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_FROM="Eazy Tech Solutions Portal <your-email@gmail.com>"
